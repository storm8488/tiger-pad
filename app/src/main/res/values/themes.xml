<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No action bar, no title: Compose draws everything. Dark, as the Panda Touch. -->
    <style name="Theme.TigerTouch" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <!-- Pal.bg: the home page draws no ground of its own, one full-screen fill less per frame. -->
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
